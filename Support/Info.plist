<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Linked into the reminders executable as its __TEXT,__info_plist section (see Package.swift). macOS reads the
  bundle identifier and the Reminders usage descriptions from it when the tool asks for Reminders access.
-->
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>io.github.neo-the-on3.reminders</string>
	<key>CFBundleName</key>
	<string>reminders</string>
	<key>CFBundleDisplayName</key>
	<string>reminders</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0-dev</string>
	<key>CFBundleVersion</key>
	<string>0.1.0</string>
	<key>LSMinimumSystemVersion</key>
	<string>26.0</string>
	<key>NSRemindersUsageDescription</key>
	<string>reminders needs access to your reminders to list, create, update and complete them.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>reminders needs access to your reminders to list, create, update and complete them.</string>
</dict>
</plist>
